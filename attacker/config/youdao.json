<updater>
	<version></version>
	<des>	<item>	<ver>10</ver>    <log>      <line><![CDATA[<h2 style="margin:0 -13px;font-size:13px;">更新至 3.1.17.9555:</h2><div style="margin:-10px -13px 0;padding-left:5px;line-height:160%">	  <br/>修复了无法在Firefox浏览器中对英文词组进行取词的问题	  <br/>修复了鼠标中键取词和剪贴板取词偶尔失效的问题	  </div>]]>	  </line>	</log>	</item>	<item>	<ver>8</ver>    <log>      <line><![CDATA[<div style="margin:-30px -13px 0;padding-left:5px;line-height:160%">	  <br/>新增Chrome浏览器划词翻译插件，安装后即可使用完美支持Chrome浏览器的划词翻译功能 <a href="http://cidian.youdao.com/chromeplus/?keyfrom=3.1update">安装介绍</a>	  <br/>支持对PDF-XChange Viewer、CAJViewer、Foxit Reader 3.0及以上版本的PDF取词	  <br/>支持对WPS 2009、Skype、千千静听等常用软件的取词	  <br/>优化了对FireFox浏览器的取词响应速度	  <br/>例句数据中新增了权威词典中的例句	  <br/>优化了查词和屏幕取词的用户体验	  <br/>新增窗口关闭时最小化到托盘设置选项	  </div>]]></line>    </log>	</item>    </des>
